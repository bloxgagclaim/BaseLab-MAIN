NODE_ENV=development
PORT=3000

# JWT
JWT_ACCESS_SECRET=baselab_access_secret_change_in_prod_32chars
JWT_REFRESH_SECRET=baselab_refresh_secret_change_in_prod_32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Stripe (use Stripe test keys)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY

# App URL (used for Stripe redirect URLs)
APP_URL=http://localhost:3000

# Email (Ethereal auto-creates test account in dev, set real SMTP for prod)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BaseLab Wholesale <noreply@baselab.com>

# Admin seed account
ADMIN_EMAIL=admin@baselab.com
ADMIN_PASSWORD=Admin123!
